# Leave both empty: the server address has a single source — what the user
# enters on the login/API-config page (persisted as lynse_api_url). These
# variables are only a compile-time fallback and must stay unset in releases.
VITE_API_URL=
VITE_WS_URL=

# Direct lynclaw chat base (e.g. http://119.97.160.133:8003). When set, AI
# chat bypasses the gateway's /api/business/ai routes and talks to the
# lynclaw HTTP API (POST /api/chat/poll + GET /api/chat/poll/{task_id}, its
# native snake_case contract). Empty keeps chat on the same gateway as every
# other request.
VITE_AI_BASE_URL=

# Build channel: "github" (public release — API-key login only) or
# "testflight" (phone SMS + WeChat login). Also selected by the
# build:github / build:testflight scripts.
VITE_BUILD_CHANNEL=github

# WeChat Open Platform appid (website app, snsapi_login). Required when the
# build channel is "testflight"; the app secret stays on the backend.
VITE_WECHAT_APP_ID=

# Web app origin hosting the /auth/wechat callback page. Desktop builds open
# the WeChat QR page in the system browser and redirect here; the desktop app
# then picks up the session by polling the backend with the same state.
VITE_WEB_APP_URL=
