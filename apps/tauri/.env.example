# Leave both empty: the server address has a single source — what the user
# enters on the login/API-config page (persisted as lynse_api_url). These
# variables are only a compile-time fallback and must stay unset in releases.
VITE_API_URL=
VITE_WS_URL=

# Build channel: "official" (the distributable 正式版 — phone SMS + WeChat
# login) or "debug" (API-key login only, throwaway test builds). Leave unset:
# packaged builds default to official, `tauri dev` to debug. The build:official
# / build:debug scripts set it explicitly.
VITE_BUILD_CHANNEL=

# PC 扫码登录 (qrconnect)：微信开放平台「网站应用」appid + 授权回调域下的
# redirect_uri。两项都设置时客户端自拼授权 URL（不依赖后端 render）；留空则
# 回退到后端 /api/auth/render 返回的授权链接。app secret 留在后端。
VITE_WECHAT_APP_ID=
VITE_WECHAT_REDIRECT_URI=

# 问题报告通道：客户端把报告 POST 到 CloudBase 的 cnb-report 云函数，由函数
# 持有 CNB token 完成建 issue（token 在函数环境变量里，不进客户端包）。
# 构建已内置正式函数地址，此处仅 dev/staging 覆盖用，留空即可。
VITE_CNB_REPORT_URL=
