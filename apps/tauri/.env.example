VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080/ws

# Build channel: "github" (public release — API-key login only) or
# "testflight" (phone SMS + WeChat login). Also selected by the
# build:github / build:testflight scripts.
VITE_BUILD_CHANNEL=github

# WeChat Open Platform appid (website app, snsapi_login). Required when the
# build channel is "testflight"; the app secret stays on the backend.
VITE_WECHAT_APP_ID=

# Web app origin hosting the /auth/wechat callback page. Desktop builds open
# the WeChat QR page in the system browser and redirect here; the desktop app
# then picks up the session by polling the backend with the same state.
VITE_WEB_APP_URL=
