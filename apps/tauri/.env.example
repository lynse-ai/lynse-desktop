# Leave both empty: the server address has a single source — what the user
# enters on the login/API-config page (persisted as lynse_api_url). These
# variables are only a compile-time fallback and must stay unset in releases.
VITE_API_URL=
VITE_WS_URL=

# Optional legacy feature-exposure override: "official" or "debug".
# Leave unset for the unified app. Login methods and server selection are
# identical in development and packaged builds; Rust --debug only selects
# compiler settings.
VITE_BUILD_CHANNEL=

# WeChat appid and state come from the selected server's /api/auth/render.
# Desktop QR callbacks use www.lynse.cn, retaining the rendered path.
# No separate build-time WeChat configuration is needed.

# 问题报告通道：客户端把报告 POST 到 CloudBase 的 cnb-report 云函数，由函数
# 持有 CNB token 完成建 issue（token 在函数环境变量里，不进客户端包）。
# 构建已内置正式函数地址，此处仅 dev/staging 覆盖用，留空即可。
VITE_CNB_REPORT_URL=
