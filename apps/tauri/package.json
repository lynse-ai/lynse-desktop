{
  "name": "@lynse/tauri",
  "productName": "Lynse",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:e2e": "vite --mode e2e --port 5183 --strictPort",
    "dev:official": "VITE_BUILD_CHANNEL=official tauri dev",
    "build": "tauri build",
    "build:debug": "VITE_BUILD_CHANNEL=debug tauri build",
    "build:official": "VITE_BUILD_CHANNEL=official tauri build",
    "ios:official": "VITE_BUILD_CHANNEL=official tauri ios build",
    "build:audio-capture": "bash ./scripts/build-audio-capture.sh",
    "test:audio-capture": "bash ./audio-capture/scripts/test-audio-capture.sh",
    "tauri": "tauri",
    "check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "test": "vitest run",
    "publish:cloudbase": "bash ./scripts/publish-cloudbase.sh",
    "mirror:cloudbase": "bash ./scripts/mirror-release-to-cloudbase.sh"
  },
  "dependencies": {
    "@lynse/core": "workspace:*",
    "@lynse/ui": "workspace:*",
    "@lynse/views": "workspace:*",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-log": "^2.0.0",
    "@tauri-apps/plugin-opener": "^2.0.0",
    "@tauri-apps/plugin-process": "^2.0.0",
    "@tauri-apps/plugin-updater": "^2.0.0",
    "@vitejs/plugin-react": "^5.1.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@lynse/tsconfig": "workspace:*",
    "@tailwindcss/vite": "^4",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@tauri-apps/cli": "^2.0.0",
    "typescript": "catalog:",
    "vite": "^8.0.0",
    "vitest": "catalog:"
  }
}
