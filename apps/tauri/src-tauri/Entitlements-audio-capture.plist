<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Exactly these two keys, per Apple's "Embedding a command-line tool in a
       sandboxed app": app-sandbox satisfies the App Store validator (ITMS-90296
       fires without it), inherit makes the helper adopt the parent's sandbox
       instead of initializing its own container (a bare app-sandbox helper
       without an application-identifier SIGTRAPs in libsecinit at launch, and
       adding the application-identifier triggers ITMS-90885). No other
       entitlements here — audio access comes from the inherited profile and
       TCC attributes the capture to the main app. -->
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <key>com.apple.security.inherit</key>
  <true/>
</dict>
</plist>
