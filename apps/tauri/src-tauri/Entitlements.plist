<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Hardened Runtime (mandatory for Developer ID notarization) blocks
         microphone access unless this entitlement is present: without it the
         TCC prompt never appears and capture fails silently, even after the
         user allows Lynse in System Settings. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- WKWebView JIT compilation under Hardened Runtime, per the Tauri
         macOS distribution docs. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
  </dict>
</plist>
