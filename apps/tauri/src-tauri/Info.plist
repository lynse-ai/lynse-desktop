<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>ITSAppUsesNonExemptEncryption</key>
  <false/>
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.productivity</string>
  <!-- Full access (not write-only): the save path resolves the default
       calendar via defaultCalendarForNewEvents, which requires full access
       on macOS 14+. Requested together with the write-only key kept for
       TCC migration on already-granted installs. -->
  <key>NSCalendarsFullAccessUsageDescription</key>
  <string>Lynse 需要日历权限来选择默认日历，并仅在你确认后将待办写入系统日历。</string>
  <key>NSCalendarsWriteOnlyAccessUsageDescription</key>
  <string>Lynse 仅在你确认后将待办写入系统日历。</string>
  <key>NSMicrophoneUsageDescription</key>
  <string>Lynse 使用麦克风记录你的发言并生成实时双语字幕。</string>
  <!-- ScreenCaptureKit requires both keys on macOS 15+: screen-recording TCC
       prompt (audio-only streams still need it) and system-audio capture. -->
  <key>NSScreenCaptureUsageDescription</key>
  <string>Lynse 需要屏幕录制权限来采集系统播放的会议声音并生成实时双语字幕；不会录制或存储你的屏幕画面。</string>
  <key>NSSystemAudioCaptureUsageDescription</key>
  <string>Lynse 捕获系统音频，以记录远端会议声音并生成实时双语字幕。</string>
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsArbitraryLoads</key>
    <true/>
  </dict>
</dict>
</plist>
