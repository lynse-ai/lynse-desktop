{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lynse",
  "version": "0.1.24",
  "identifier": "app.lynse.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @lynse/tauri build:audio-capture && pnpm --filter @lynse/tauri exec vite --host 127.0.0.1",
    "beforeBuildCommand": "pnpm --filter @lynse/tauri build:audio-capture && pnpm --filter @lynse/tauri exec vite build",
    "devUrl": "http://127.0.0.1:5174",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": " ",
        "width": 720,
        "height": 480,
    "minWidth": 720,
    "minHeight": 480,
    "titleBarStyle": "Overlay",
        "trafficLightPosition": { "x": 8, "y": 13 }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/funasr_transcribe.py": "funasr_transcribe.py",
      "resources/mlx_transcribe.py": "mlx_transcribe.py",
      "resources/sidecars/audio-capture": "audio-capture"
    },
    "macOS": {
      "minimumSystemVersion": "15.0",
      "infoPlist": "Info.plist"
    }
  }
}
