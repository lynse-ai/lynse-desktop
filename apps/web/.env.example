NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws

# Build channel: "official" (the distributable 正式版 — phone SMS + WeChat
# login) or "debug" (API-key login only, throwaway test builds). Leave unset:
# production builds default to official, dev to debug. The build:official /
# build:debug scripts set it explicitly.
NEXT_PUBLIC_BUILD_CHANNEL=

# WeChat Open Platform appid (website app, snsapi_login). Required for the
# official channel. The app secret stays on the backend.
NEXT_PUBLIC_WECHAT_APP_ID=
