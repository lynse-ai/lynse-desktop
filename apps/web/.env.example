NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws

# Build channel: "official" (the distributable 正式版 — phone SMS + WeChat
# login) or "debug" (API-key login only, throwaway test builds). Leave unset:
# production builds default to official, dev to debug. The build:official /
# build:debug scripts set it explicitly.
NEXT_PUBLIC_BUILD_CHANNEL=

# Account-center SSO ("Sign in with Lynse" on the login page). Both vars must
# be set for the entry to appear; unset keeps the login page unchanged. The
# client is registered on the gateway side via LYNSE_ID_CLIENTS (type public,
# with <origin>/auth/sso whitelisted as a redirect URI). The flow returns to
# /auth/sso, which completes the exchange.
NEXT_PUBLIC_LYNSE_SSO_URL=
NEXT_PUBLIC_LYNSE_SSO_CLIENT_ID=

# PostHog 行为统计与漏斗（出海/海外）
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry 崩溃与异常监控（出海/海外）
NEXT_PUBLIC_SENTRY_DSN=

