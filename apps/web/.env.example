NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws

# Build channel: "github" (public release — API-key login only) or
# "testflight" (phone SMS + WeChat login). Also selected by the
# build:github / build:testflight scripts.
NEXT_PUBLIC_BUILD_CHANNEL=github

# WeChat Open Platform appid (website app, snsapi_login). Required when the
# build channel is "testflight". The app secret stays on the backend.
NEXT_PUBLIC_WECHAT_APP_ID=
